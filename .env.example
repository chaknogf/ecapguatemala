# ECAP CRM Académico — plantilla de configuración
# El backend lee backend/.env (ver backend/.env.example).
# Este archivo existe solo como referencia rápida para desarrollo local.
# NUNCA suba secretos reales al repositorio.

POSTGRES_DB=ecap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecap
ENVIRONMENT=development
DEBUG=true
JWT_SECRET=dev-secret-ecap-change-in-production-please-32chars
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CORS_ORIGINS=["http://localhost:4200"]
