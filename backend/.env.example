# ECAP CRM Académico — configuración de DESARROLLO
# Copie este archivo a backend/.env y ajuste los valores.
# NUNCA suba un .env con secretos al repositorio.

# ------------------------------------------------ PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecap
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ------------------------------------------------ Aplicación
APP_NAME=ECAP CRM Académico
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------ Seguridad / JWT
# Generar uno real con: python -m app.cli secret
JWT_SECRET=dev-secret-ecap-change-in-production-please-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
ISSUER=ecap
AUDIENCE=ecap-api

# ------------------------------------------------ Políticas de acceso
# 8 permite la contraseña de demo "Demo1234!" (9 caracteres).
# En producción use 10 o más.
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------ CORS
CORS_ORIGINS=["http://localhost:4200"]

# ------------------------------------------------ Archivos (opcional)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=5
BACKUP_DIR=data/backups
